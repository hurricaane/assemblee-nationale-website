# Copy to .env and fill in. Every variable here must also be in shared/lib/env.ts
NODE_ENV=development
# Public URL of the site. Optional in development, required for production builds
NUXT_SITE_URL=http://localhost:3000
# Signs OG image URLs (32+ characters). Optional in development, required for production builds.
# Generate one with: pnpx nuxt-og-image generate-secret
NUXT_APP_SECRET=
